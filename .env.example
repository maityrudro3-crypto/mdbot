# ===== King Rudro WhatsApp Bot =====
NODE_ENV=production

# Your WhatsApp number in international format, digits only (example: 9198xxxxxxxx)
OWNER_NUMBER=
OWNER_NAME=King Rudro
BOT_NAME=King Rudro
AUTHOR=King Rudro
PACKNAME=King Rudro

PREFIX=.
TIMEZONE=Asia/Kolkata
WORK_TYPE=public

# Railway persistence: create a Volume mounted at /app/storage
SESSION_DIR=/app/storage/sessions
META_FILE=/app/storage/data/sessions.json
AUTH_DIR=/app/storage/auth

# Database/runtime
DB_DIR=/app/storage/data

# Telegram integration is disabled by default.
OFFTELEBOT=true
BOT_TOKEN_TELEGRAM=
TG_GROUP_ID=
TG_GROUP_LINK=
WA_CHANNEL_LINK=

# Optional menu/newsletter settings
MENU_CHANNEL_JID=
MENU_CHANNEL_NAME=King Rudro
MENU_SERVER_MESSAGE_ID=1
FOLLOW_CHANNELS=
BOT_THUMBNAIL_URL=
BOT_CHANNEL_URL=

# Optional
MONGODB_URI=
DATABASE_URL=
GIST_URL=
STATUS_REACT=false
LOG_LEVEL=info
